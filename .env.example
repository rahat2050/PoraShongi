# ------------------------------------------------------------------
# PoraShongi (পড়াসঙ্গী) — environment variables
# Copy this file to `.env.local` for local development.
#
#   cp .env.example .env.local
#
# NEVER commit real secrets. The `.env*` pattern is gitignored,
# except this example file.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — SERVER ONLY. Never expose to the browser.
# Used by `src/lib/supabase/admin.ts` for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (Dashboard → Account Details)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Unsigned upload preset (Settings → Upload → Upload presets)
# See docs/cloudinary-setup.md for how to create it.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=porashongi_profile_unsigned
