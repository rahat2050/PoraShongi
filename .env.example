# ------------------------------------------------------------------
# PoraSathi (পড়াসাথী) — environment variables
# A platform by FS Coaching
#
#   cp .env.example .env.local
#
# Supabase → Project Settings → API এ গিয়ে URL আর anon key কপি করো।
# ------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, browser এ যাবে না। (admin কাজের জন্য)
SUPABASE_SERVICE_ROLE_KEY=

# App — production deployment-এ canonical HTTPS origin ব্যবহার করুন।
# Local development-এ চাইলে http://localhost:3000 দিয়ে override করা যায়।
NEXT_PUBLIC_SITE_URL=https://porasathi.rahatahmed.site

# Cloudinary (ঐচ্ছিক — প্রোফাইল ছবি upload করতে)
# Cloudinary Dashboard → Account Details → Cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Cloudinary → Settings → Upload → Upload presets.
# Unsigned হলে preset-এ folder=porasathi/profiles, allowed formats JPG/PNG/WebP,
# max file size 5 MB, moderation ও account quota অবশ্যই enforce করুন।
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=porasathi_profile
