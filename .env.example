# ------------------------------------------------------------------
# PoraSathi (পড়াসাথী) — environment variables
# A platform by FS Coaching
#
#   cp .env.example .env.local
#
# Supabase → Project Settings → API এ গিয়ে URL আর anon key কপি করো।
# ------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, browser এ যাবে না। (admin কাজের জন্য)
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (ঐচ্ছিক — প্রোফাইল ছবি upload করতে)
# Cloudinary Dashboard → Account Details → Cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Cloudinary → Settings → Upload → Upload presets (unsigned)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=porasathi_profile
